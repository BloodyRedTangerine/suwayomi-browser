+  return (stack_value){.i = io_result(thread, count, true, args[2].i)};
+}
+DECLARE_NATIVE("sun/nio/ch", UnixFileDispatcherImpl, pread0, "(Ljava/io/FileDescriptor;JIJ)I") {
