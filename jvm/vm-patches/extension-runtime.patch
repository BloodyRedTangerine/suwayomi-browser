diff --git a/natives/share/java/io/descriptor-access.h b/natives/share/java/io/descriptor-access.h
new file mode 100644
index 0000000..5745d7c
--- /dev/null
+++ b/natives/share/java/io/descriptor-access.h
@@ -0,0 +1,16 @@
+#ifndef BJVM_DESCRIPTOR_ACCESS_H
+#define BJVM_DESCRIPTOR_ACCESS_H
+#include <errno.h>
+#include <fcntl.h>
+
+// WasmFS does not consistently reject operations through descriptors opened
+// in the opposite access mode. Check at the Java I/O boundary, not file mode
+// bits: chmod does not change the access rights of an already-open descriptor.
+static inline bool jvm_descriptor_access(int fd, bool writing) {
+  int flags = fcntl(fd, F_GETFL);
+  if (flags < 0) return false;
+  int access = flags & O_ACCMODE;
+  if (writing ? access == O_RDONLY : access == O_WRONLY) { errno = EBADF; return false; }
+  return true;
+}
+#endif
