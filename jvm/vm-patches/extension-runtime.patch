+// FileChannel addresses point into the VM's native (WASM linear) memory.
+static s64 io_result(vm_thread *thread, ssize_t count, bool reading, int requested) {
+  if (count >= 0) return reading && count == 0 && requested != 0 ? -1 : count;
+  if (errno == EAGAIN) return -2;
+  if (errno == EINTR) return -3;
+  raise_vm_exception(thread, STR("java/io/IOException"), STR("Browser filesystem I/O failed"));
