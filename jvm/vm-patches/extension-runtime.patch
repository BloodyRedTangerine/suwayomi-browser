diff --git a/natives/share/java/util/zip/Deflater.c b/natives/share/java/util/zip/Deflater.c
new file mode 100644
index 0000000..4000e02
--- /dev/null
+++ b/natives/share/java/util/zip/Deflater.c
@@ -0,0 +1,93 @@
+// Suwayomi browser port: JDK Deflater natives backed by Emscripten's zlib.
+// Same MIT license as b-jvm. JDK's packed result encodes read/written counts.
+#include <natives-dsl.h>
+#include <zlib.h>
+
+DECLARE_NATIVE("java/util/zip", Deflater, init, "(IIZ)J") {
+  z_stream *stream = calloc(1, sizeof(*stream));
+  if (!stream) {
+    raise_vm_exception_no_msg(thread, STR("java/lang/OutOfMemoryError"));
+    return value_null();
+  }
+  int status = deflateInit2(stream, args[0].i, Z_DEFLATED, args[2].i ? -MAX_WBITS : MAX_WBITS, 8, args[1].i);
+  if (status != Z_OK) {
+    free(stream);
+    raise_vm_exception_no_msg(thread, STR("java/lang/IllegalArgumentException"));
+    return value_null();
+  }
+  arrput(thread->vm->deflater_streams, stream);
+  return (stack_value){.l = (intptr_t)stream};
+}
+
+static stack_value compress_bytes(vm_thread *thread, z_stream *stream, u8 *input, int input_size,
+                                  u8 *output, int output_size, int flush, int params) {
+  stream->next_in = input;
+  stream->avail_in = input_size;
+  stream->next_out = output;
+  stream->avail_out = output_size;
+  int changing = params & 1;
+  int status = changing ? deflateParams(stream, params >> 3, (params >> 1) & 3) : deflate(stream, flush);
+  if (status != Z_OK && status != Z_STREAM_END && status != Z_BUF_ERROR) {
+    raise_vm_exception_no_msg(thread, STR("java/lang/InternalError"));
+    return value_null();
+  }
+  u64 read = input_size - stream->avail_in;
+  u64 written = output_size - stream->avail_out;
+  u64 completed = status == Z_STREAM_END;
+  u64 retry = changing && status != Z_OK;
+  return (stack_value){.l = (s64)(read | (written << 31) | (completed << 62) | (retry << 63))};
+}
+
+DECLARE_NATIVE("java/util/zip", Deflater, deflateBytesBytes, "(J[BII[BIIII)J") {
+  return compress_bytes(thread, (z_stream *)(intptr_t)args[0].l,
+    (u8 *)ArrayData(args[1].handle->obj) + args[2].i, args[3].i,
+    (u8 *)ArrayData(args[4].handle->obj) + args[5].i, args[6].i, args[7].i, args[8].i);
+}
+
+DECLARE_NATIVE("java/util/zip", Deflater, deflateBytesBuffer, "(J[BIIJIII)J") {
+  return compress_bytes(thread, (z_stream *)(intptr_t)args[0].l,
+    (u8 *)ArrayData(args[1].handle->obj) + args[2].i, args[3].i,
+    (u8 *)(intptr_t)args[4].l, args[5].i, args[6].i, args[7].i);
+}
+
+DECLARE_NATIVE("java/util/zip", Deflater, deflateBufferBytes, "(JJI[BIIII)J") {
+  return compress_bytes(thread, (z_stream *)(intptr_t)args[0].l,
+    (u8 *)(intptr_t)args[1].l, args[2].i,
+    (u8 *)ArrayData(args[3].handle->obj) + args[4].i, args[5].i, args[6].i, args[7].i);
+}
+
+DECLARE_NATIVE("java/util/zip", Deflater, deflateBufferBuffer, "(JJIJIII)J") {
+  return compress_bytes(thread, (z_stream *)(intptr_t)args[0].l,
+    (u8 *)(intptr_t)args[1].l, args[2].i, (u8 *)(intptr_t)args[3].l, args[4].i, args[5].i, args[6].i);
+}
+
+DECLARE_NATIVE("java/util/zip", Deflater, setDictionary, "(J[BII)V") {
+  int status = deflateSetDictionary((z_stream *)(intptr_t)args[0].l, (u8 *)ArrayData(args[1].handle->obj) + args[2].i, args[3].i);
+  if (status != Z_OK) raise_vm_exception_no_msg(thread, STR("java/lang/IllegalArgumentException"));
+  return value_null();
+}
+
+DECLARE_NATIVE("java/util/zip", Deflater, setDictionaryBuffer, "(JJI)V") {
+  int status = deflateSetDictionary((z_stream *)(intptr_t)args[0].l, (u8 *)(intptr_t)args[1].l, args[2].i);
+  if (status != Z_OK) raise_vm_exception_no_msg(thread, STR("java/lang/IllegalArgumentException"));
+  return value_null();
+}
+
+DECLARE_NATIVE("java/util/zip", Deflater, getAdler, "(J)I") {
+  return (stack_value){.i = ((z_stream *)(intptr_t)args[0].l)->adler};
+}
+
+DECLARE_NATIVE("java/util/zip", Deflater, reset, "(J)V") {
+  deflateReset((z_stream *)(intptr_t)args[0].l);
+  return value_null();
+}
+
+DECLARE_NATIVE("java/util/zip", Deflater, end, "(J)V") {
+  z_stream *stream = (z_stream *)(intptr_t)args[0].l;
+  deflateEnd(stream);
+  for (int i = 0; i < arrlen(thread->vm->deflater_streams); ++i) {
+    if (thread->vm->deflater_streams[i] == stream) { arrdelswap(thread->vm->deflater_streams, i); break; }
+  }
+  free(stream);
+  return value_null();
+}
