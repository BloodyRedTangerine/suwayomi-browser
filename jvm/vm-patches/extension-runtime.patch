 DECLARE_NATIVE("java/io", FileOutputStream, initIDs, "()V") { return value_null(); }
 
+DECLARE_NATIVE("java/io", FileOutputStream, open0, "(Ljava/lang/String;Z)V") {
+  if (!args[0].handle->obj) { raise_null_pointer_exception(thread); return value_null(); }
+  heap_string filename = AsHeapString(args[0].handle->obj, on_oom);
+  obj_header *fd = LoadFieldObject(obj->obj, "java/io/FileDescriptor", "fd");
+  int flags = O_WRONLY | O_CREAT | (args[1].i ? O_APPEND : O_TRUNC);
+  int opened;
+  do { opened = open(filename.chars, flags, 0666); } while (opened < 0 && errno == EINTR);
+  StoreFieldInt(fd, "fd", opened);
+  if (opened < 0) {
+    raise_vm_exception(thread, STR("java/io/FileNotFoundException"), STR("Could not open file"));
+    if (thread->current_exception && thread->current_exception->descriptor == cached_classes(thread->vm)->file_not_found_exception)
+      StoreFieldObject(thread->current_exception, "java/lang/String", "detailMessage", args[0].handle->obj);
+  }
+  free_heap_str(filename);
+  return value_null();
+on_oom:
+  return value_null();
+}
+
+DECLARE_NATIVE("java/io", FileOutputStream, write, "(IZ)V") {
+  obj_header *fd = LoadFieldObject(obj->obj, "java/io/FileDescriptor", "fd");
+  int unix_fd = LoadFieldInt(fd, "fd");
+  if (!jvm_descriptor_access(unix_fd, true)) { raise_vm_exception(thread, STR("java/io/IOException"), STR("Descriptor is not writable")); return value_null(); }
+  char byte = (unsigned char)args[0].i;
+  if (unix_fd == 1 && thread->vm->write_stdout) thread->vm->write_stdout(&byte, 1, thread->vm->stdio_override_param);
+  else if (unix_fd == 2 && thread->vm->write_stderr) thread->vm->write_stderr(&byte, 1, thread->vm->stdio_override_param);
+  else {
+    ssize_t written;
+    do { written = write(unix_fd, &byte, 1); } while (written < 0 && errno == EINTR);
+    if (written != 1) raise_vm_exception(thread, STR("java/io/IOException"), STR("Error writing file"));
+  }
+  return value_null();
+}
