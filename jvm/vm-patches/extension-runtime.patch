+  ssize_t count = jvm_descriptor_access(fd, true) ? write(fd, (const void *)(uintptr_t)args[1].l, args[2].i) : -1;
+  return (stack_value){.i = io_result(thread, count, false, args[2].i)};
+}
+DECLARE_NATIVE("sun/nio/ch", UnixFileDispatcherImpl, pwrite0, "(Ljava/io/FileDescriptor;JIJ)I") {
+  int fd = LoadFieldInt(args[0].handle->obj, "fd");
+  ssize_t count = jvm_descriptor_access(fd, true) ? pwrite(fd, (const void *)(uintptr_t)args[1].l, args[2].i, args[3].l) : -1;
+  return (stack_value){.i = io_result(thread, count, false, args[2].i)};
+}
+DECLARE_NATIVE("sun/nio/ch", UnixFileDispatcherImpl, seek0, "(Ljava/io/FileDescriptor;J)J") {
+  int fd = LoadFieldInt(args[0].handle->obj, "fd");
+  off_t position = lseek(fd, args[1].l < 0 ? 0 : args[1].l, args[1].l < 0 ? SEEK_CUR : SEEK_SET);
+  if (position < 0) raise_vm_exception(thread, STR("java/io/IOException"), STR("Could not seek browser file"));
+  return (stack_value){.l = position};
