+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. https://mozilla.org/MPL/2.0/.
+ */
+import { ApolloLink } from '@apollo/client';
+import { Observable } from 'rxjs';
+import { valueFromASTUntyped, GraphQLError } from 'graphql';
+import { getBrowserBackend } from '@browser-local/webui/backend.mjs';
+import { normalizeVariables } from '@browser-local/webui/variables.mjs';
+import { getPermissionRecovery } from '@browser-local/extensions/permission-recovery.mjs';
+
+const backend = () => getBrowserBackend();
+const argumentsFor = (node: any, variables: any) => Object.fromEntries((node.arguments || []).map((arg: any) => [arg.name.value, valueFromASTUntyped(arg.value, variables)]));
+const included = (node: any, variables: any) => (node.directives || []).every((directive: any) => {
+    const { if: condition } = argumentsFor(directive, variables);
+    return directive.name.value === 'skip' ? !condition : directive.name.value === 'include' ? !!condition : true;
+});
+function fields(selection: any, fragments: any, variables: any, type?: string): any[] {
+    return selection.selections.flatMap((node: any) => {
+        if (!included(node, variables)) return [];
+        if (node.kind === 'Field') return [node];
+        const fragment = node.kind === 'FragmentSpread' ? fragments[node.name.value] : node;
+        if (type && fragment.typeCondition?.name.value !== type) return [];
+        return fields(fragment.selectionSet, fragments, variables, type);
+    });
+}
+async function project(value: any, selection: any, fragments: any, variables: any): Promise<any> {
+    value = await value;
+    if (value == null) return null;
+    if (Array.isArray(value)) return Promise.all(value.map(item => project(item, selection, fragments, variables)));
+    const output: any = {};
+    for (const node of fields(selection, fragments, variables, value.__typename)) {
+        const name = node.name.value, key = node.alias?.value || name;
+        const member = value[name];
+        const resolved = typeof member === 'function' ? await member(argumentsFor(node, variables)) : await member;
+        const result = node.selectionSet ? await project(resolved, node.selectionSet, fragments, variables) : resolved ?? null;
+        output[key] = output[key] && result && !Array.isArray(result) && typeof result === 'object' ? { ...output[key], ...result } : result;
+    }
+    return output;
+}
+export const localFetch: typeof fetch = (input, options) => backend().fetch(String(input), options);
+export function createBrowserLocalLink(): ApolloLink {
+    return new ApolloLink(operation => new Observable(observer => {
+        const fragments = Object.fromEntries(operation.query.definitions.filter((node: any) => node.kind === 'FragmentDefinition').map((node: any) => [node.name.value, node]));
+        const definition: any = operation.query.definitions.find((node: any) => node.kind === 'OperationDefinition');
+        // Match JSON transport semantics: undefined object fields are omitted.
+        const variables = normalizeVariables({ ...Object.fromEntries((definition.variableDefinitions || []).filter((node: any) => node.defaultValue).map((node: any) => [node.variable.name.value, valueFromASTUntyped(node.defaultValue)])), ...operation.variables });
+        let disposed = false;
+        let running = false;
+        let dirty = false;
+        let knownDownloadIds: number[] | undefined;
+        const run = async () => {
+            if (disposed) return;
+            if (running) { dirty = true; return; }
+            running = true;
+            dirty = false;
+            try {
+                const data: any = {};
+                let nextKnownDownloadIds = knownDownloadIds;
+                for (const node of fields(definition.selectionSet, fragments, variables)) {
+                    const args = argumentsFor(node, variables);
+                    if (node.name.value === 'downloadStatusChanged') args.knownChapterIds = knownDownloadIds;
+                    const permissionKey = node.name.value === 'addExtensionStore'
+                        ? `repository:${args.input.indexUrl}`
+                        : ['updateExtension', 'updateExtensions'].includes(node.name.value) && !args.input.patch?.uninstall
+                            ? `install:${args.input.id || args.input.ids?.join(',')}` : null;
+                    const value = permissionKey
+                        ? await getPermissionRecovery().run(permissionKey, () => backend().resolve(node.name.value, args))
+                        : await backend().resolve(node.name.value, args);
+                    if (node.name.value === 'downloadStatusChanged') nextKnownDownloadIds = value.currentChapterIds;
+                    data[node.alias?.value || node.name.value] = node.selectionSet ? await project(value, node.selectionSet, fragments, variables) : value;
+                }
+                if (!disposed) { observer.next({ data }); knownDownloadIds = nextKnownDownloadIds; }
+            } catch (error: any) {
+                console.error(`Local GraphQL ${operation.operationName}:`, error);
+                if (!disposed) observer.next({ errors: [new GraphQLError(error.message)] });
+            } finally {
+                running = false;
+                if (dirty && definition.operation === 'subscription' && !disposed) void run();
+                if (definition.operation !== 'subscription' && !disposed) observer.complete();
+            }
+        };
+        void run();
+        if (definition.operation === 'subscription') backend().listeners.add(run);
+        return () => { disposed = true; backend().listeners.delete(run); };
+    }));
+}
