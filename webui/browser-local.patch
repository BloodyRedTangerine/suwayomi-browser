@@ -0,0 +1,119 @@
+/* Copyright (C) Contributors to the Suwayomi project. MPL-2.0. */
+import Alert from '@mui/material/Alert';
+import Button from '@mui/material/Button';
+import IconButton from '@mui/material/IconButton';
+import CloseIcon from '@mui/icons-material/Close';
+import Stack from '@mui/material/Stack';
+import { useEffect, useState } from 'react';
+import { getBrowserBackend } from '@browser-local/webui/backend.mjs';
+import { missingPermissionOrigins, requestPermissionOrigins, sourcePermissionOrigins } from '@browser-local/extensions/permissions.mjs';
+import { BrowserPermissionRequests } from './BrowserPermissionPrompt';
+import { useNavBarContext } from '@/features/navigation-bar/NavbarContext.tsx';
+
+const LAUNCHER_HINT_KEY = 'suwayomi-browser:launcher-hint:dismissed:v1';
+
+function shouldShowLauncherHint() {
+    try {
+        return globalThis.localStorage.getItem(LAUNCHER_HINT_KEY) !== 'yes';
+    } catch {
+        return true;
+    }
+}
+
+export function BrowserLocalStatus() {
+    const browser = (globalThis as any).browser ?? (globalThis as any).chrome;
+    const { bottomBarHeight } = useNavBarContext();
+    const [missing, setMissing] = useState<string[] | null>(null);
+    const [error, setError] = useState('');
+    const [storageWarning, setStorageWarning] = useState('');
+    const [storageDismissed, setStorageDismissed] = useState(false);
+    const [showLauncherHint, setShowLauncherHint] = useState(shouldShowLauncherHint);
+
+    useEffect(() => {
+        let active = true;
+        if (import.meta.env.VITE_BROWSER_LOCAL !== 'true' || !browser?.runtime?.id) return () => { active = false; };
+        (async () => {
+            try {
+                const sources = await getBrowserBackend().manager.sources();
+                const origins = sourcePermissionOrigins(sources);
+                const next = await missingPermissionOrigins(browser, origins);
+                if (active) setMissing(next);
+            } catch (cause: any) {
+                if (active) setError(cause.message);
+            }
+        })();
+        return () => { active = false; };
+    }, [browser?.runtime?.id]);
+
+    useEffect(() => {
+        if (import.meta.env.VITE_BROWSER_LOCAL !== 'true' || !browser?.runtime?.id) return;
+        try { void Promise.resolve(browser.runtime.sendMessage({ type: 'suwayomi:register-app-tab' })).catch(() => {}); }
+        catch { /* a stale extension context does not prevent local reading */ }
+    }, [browser?.runtime?.id]);
+
+    useEffect(() => {
+        let active = true;
+        if (import.meta.env.VITE_BROWSER_LOCAL !== 'true' || !browser?.runtime?.id) return () => { active = false; };
+        (async () => {
+            const storage = globalThis.navigator?.storage;
+            if (!storage?.estimate) return;
+            try {
+                const estimate = await storage.estimate();
+                if (!active) return;
+                const { usage, quota } = estimate;
+                if (usage != null && quota != null && quota > 0 && usage / quota >= 0.9) {
+                    setStorageWarning(`Browser storage is nearly full (${Math.round((usage / quota) * 100)}% used). Review storage in Settings → About.`);
+                    setStorageDismissed(false);
+                } else {
+                    setStorageWarning('');
+                }
+            } catch (cause: any) {
+                if (active) {
+                    setStorageWarning(`Browser storage could not be checked: ${cause?.message || 'storage estimate failed'}. Review storage in Settings → About.`);
+                    setStorageDismissed(false);
+                }
+            }
+        })();
+        return () => { active = false; };
+    }, [browser?.runtime?.id]);
+
+    if (import.meta.env.VITE_BROWSER_LOCAL !== 'true' || !browser?.runtime?.id) return null;
+
+    const hosts = (missing || []).map(origin => origin.replace(/^https?:\/\//, '').replace(/\/\*$/, '')).join(', ');
+    const noticeBottom = `calc(max(136px, ${Math.ceil(bottomBarHeight)}px) + env(safe-area-inset-bottom) + 8px)`;
+    const noticeSx = {
+        position: 'fixed',
+        left: { xs: 'max(8px, env(safe-area-inset-left))', sm: 'auto' },
+        right: { xs: 'max(8px, env(safe-area-inset-right))', sm: 16 },
+        bottom: { xs: noticeBottom, sm: `calc(max(96px, ${Math.ceil(bottomBarHeight)}px) + 8px)` },
+        width: { xs: 'auto', sm: 'min(460px, calc(100vw - 32px))' },
+        maxWidth: { xs: 'none', sm: 460 },
+        maxHeight: { xs: 'min(40vh, calc(100dvh - 240px - env(safe-area-inset-top)))', sm: 'min(40vh, calc(100dvh - 160px))' },
+        overflowY: 'auto',
+        zIndex: 1600,
+        touchAction: 'pan-y',
+    } as const;
+
+    return <Stack spacing={1} data-testid="browser-action-notices" sx={noticeSx}>
+        <BrowserPermissionRequests />
+        {!!missing?.length && <Alert severity="info" action={<Button color="inherit" onClick={async () => {
+            try {
+                await requestPermissionOrigins(browser, missing);
+                const sources = await getBrowserBackend().manager.sources();
+                setMissing(await missingPermissionOrigins(browser, sourcePermissionOrigins(sources)));
+            } catch (cause: any) { setError(cause.message); }
+        }}>Allow source hosts</Button>}>
+            Browser-local preview. Source code and data stay in this browser. Allow access only for installed source hosts: {hosts}.
+            {error && ` ${error}`}
+        </Alert>}
+        {storageWarning && !storageDismissed && <Alert severity="warning" role="alert" action={<IconButton aria-label="Dismiss storage warning" color="inherit" size="small" onClick={() => setStorageDismissed(true)}><CloseIcon fontSize="small" /></IconButton>}>
+            {storageWarning}
+        </Alert>}
+        {showLauncherHint && <Alert severity="info" action={<Button color="inherit" size="small" onClick={() => {
+            try { globalThis.localStorage.setItem(LAUNCHER_HINT_KEY, 'yes'); } catch { /* dismissal is still local to this view */ }
+            setShowLauncherHint(false);
+        }}>Dismiss</Button>}>
+            On Firefox for Android, reopen Suwayomi Browser from Extensions → Suwayomi Browser → Settings, or while any web page is open use menu ⋮ → Extensions → Suwayomi Browser. Bookmark this page for one-tap access until the add-on is reinstalled.
+        </Alert>}
+    </Stack>;
+}
diff --git a/src/base/components/BrowserPermissionPrompt.tsx b/src/base/components/BrowserPermissionPrompt.tsx
new file mode 100644
index 0000000..256eaf6
--- /dev/null
+++ b/src/base/components/BrowserPermissionPrompt.tsx
@@ -0,0 +1,49 @@
+/* Copyright (C) Contributors to the Suwayomi project. MPL-2.0. */
+import Alert from '@mui/material/Alert';
+import Button from '@mui/material/Button';
+import Stack from '@mui/material/Stack';
+import { useEffect, useState } from 'react';
+import { getPermissionRecovery } from '@browser-local/extensions/permission-recovery.mjs';
+import { requestPermissionOrigins } from '@browser-local/extensions/permissions.mjs';
+
+export function useBrowserPermissionRequests() {
+    const recovery = getPermissionRecovery();
+    const [requests, setRequests] = useState<any[]>(() => recovery.snapshot());
+    useEffect(() => {
+        const update = () => setRequests(recovery.snapshot());
+        const unsubscribe = recovery.subscribe(update);
+        update();
+        return unsubscribe;
+    }, [recovery]);
+    return requests;
+}
+
+export function BrowserPermissionPrompt({ request, repository = false }: { request: any; repository?: boolean }) {
+    const recovery = getPermissionRecovery();
+    const origins = request.origins || [request.origin];
+    const patterns = origins.join(', ');
+    return <Alert severity={request.granted ? 'success' : 'info'}
+        action={request.granted
+            ? <Button color="inherit" onClick={() => recovery.dismiss(request.origin)}>Dismiss</Button>
+            : <Button color="inherit" disabled={request.ready === false} onClick={async () => {
+                try {
+                    const allowed = await requestPermissionOrigins((globalThis as any).chrome, origins);
+                    await recovery.granted(origins, allowed);
+                } catch (error) { recovery.error(request.origin, error); }
+            }}>Allow {patterns}</Button>}>
+        {request.granted
+            ? `Access allowed for ${patterns}. Permission-failed reader images and download rows resume automatically. Retry other source actions manually.`
+            : repository
+                ? `This repository redirects to ${patterns} — Allow access to continue the same add.`
+                : `Browser access is required for ${patterns}. ${request.ready === false ? 'Collecting related hosts… ' : ''}Allow access to continue permission-failed reader images, downloads and pending operations; retry other source actions manually.`}
+        {request.error && ` ${request.error}`}
+    </Alert>;
+}
+
+export function BrowserPermissionRequests() {
+    const requests = useBrowserPermissionRequests().filter(request => !request.operations.some((key: string) => key.startsWith('repository:')));
+    if (!requests.length) return null;
+    return <Stack spacing={1} sx={{ width: '100%' }} data-testid="browser-permission-requests">
+        {requests.map(request => <BrowserPermissionPrompt key={request.origin} request={request} />)}
+    </Stack>;
+}
