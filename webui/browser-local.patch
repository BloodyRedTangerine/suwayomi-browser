@@ -0,0 +1,105 @@
+/* Copyright (C) Contributors to the Suwayomi project. MPL-2.0. */
+import { useEffect, useState } from 'react';
+import Button from '@mui/material/Button';
+import Stack from '@mui/material/Stack';
+import Typography from '@mui/material/Typography';
+import Alert from '@mui/material/Alert';
+import { getBrowserBackend } from '@browser-local/webui/backend.mjs';
+import { makeToast } from '@/base/utils/Toast.ts';
+
+export function BrowserLocalDiagnostics() {
+    const runtime = (globalThis as any).chrome?.runtime ?? (globalThis as any).browser?.runtime;
+    const [copying, setCopying] = useState(false);
+    const [storageRefresh, setStorageRefresh] = useState(0);
+    const [storageMetrics, setStorageMetrics] = useState<{
+        usage?: number;
+        quota?: number;
+        persisted: boolean | null;
+        pageCount: number;
+        pageBytes: number;
+        databaseBytes: number;
+    } | null>(null);
+    const [storageError, setStorageError] = useState('');
+
+    useEffect(() => {
+        let active = true;
+        if (import.meta.env.VITE_BROWSER_LOCAL !== 'true' || !runtime?.id) return () => { active = false; };
+        (async () => {
+            try {
+                const backend = getBrowserBackend();
+                await backend.loading;
+                const storage = globalThis.navigator?.storage;
+                let estimate: StorageEstimate = {};
+                try { estimate = await storage?.estimate?.() ?? {}; } catch { /* quota estimate is optional */ }
+                let persisted: boolean | null = null;
+                try { persisted = await storage?.persisted?.() ?? null; } catch { /* persistence status is optional */ }
+                const [pages, library] = await Promise.all([
+                    backend.store.getPrefixStats('settings', 'webui:page:'),
+                    backend.store.get('settings', 'webui:database'),
+                ]);
+                const serialized = JSON.stringify(library?.value ?? null);
+                const databaseBytes = new TextEncoder().encode(serialized ?? '').byteLength;
+                if (active) {
+                    setStorageMetrics({
+                        usage: estimate.usage,
+                        quota: estimate.quota,
+                        persisted,
+                        pageCount: pages.count,
+                        pageBytes: pages.blobBytes,
+                        databaseBytes,
+                    });
+                    setStorageError('');
+                }
+            } catch (cause: any) {
+                if (active) setStorageError(cause?.message || 'Storage metrics are unavailable');
+            }
+        })();
+        return () => { active = false; };
+    }, [runtime?.id, storageRefresh]);
+
+    if (import.meta.env.VITE_BROWSER_LOCAL !== 'true' || !runtime?.id) return null;
+
+    const formatBytes = (value?: number) => {
+        if (value == null || !Number.isFinite(value) || value < 0) return 'unknown';
+        if (value < 1024) return `${Math.round(value)} B`;
+        const units = ['KiB', 'MiB', 'GiB', 'TiB'];
+        let amount = value, unit = -1;
+        do { amount /= 1024; unit++; } while (amount >= 1024 && unit < units.length - 1);
+        return `${amount.toFixed(1)} ${units[unit]}`;
+    };
+
+    const copyDiagnostics = async () => {
+        if (copying) return;
+        setCopying(true);
+        try {
+            const text = await getBrowserBackend().getDiagnostics();
+            await globalThis.navigator.clipboard.writeText(text);
+            makeToast('Redacted diagnostics copied. Review before sharing.', 'success');
+        } catch {
+            makeToast('Could not copy diagnostics. Check clipboard access and try again.', 'error');
+        } finally {
+            setCopying(false);
+        }
+    };
+
+    return (
+        <Stack spacing={1}>
+            <Button variant="outlined" onClick={copyDiagnostics} disabled={copying}>
+                {copying ? 'Preparing diagnostics…' : 'Copy diagnostics'}
+            </Button>
+            <Typography variant="body2" color="text.secondary">
+                Copies a redacted summary locally. Nothing is sent automatically; review it before sharing.
+            </Typography>
+            <Typography variant="subtitle2" sx={{ pt: 1 }}>Browser storage</Typography>
+            {storageError ? <Alert severity="error">{storageError}</Alert> : <Typography variant="body2" color="text.secondary">
+                {storageMetrics ? <>
+                    {formatBytes(storageMetrics.usage)} used / {formatBytes(storageMetrics.quota)} quota; persisted: {storageMetrics.persisted == null ? 'unknown' : storageMetrics.persisted ? 'yes' : 'no'}.<br />
+                    Cached pages: {storageMetrics.pageCount} ({formatBytes(storageMetrics.pageBytes)}); library database: {formatBytes(storageMetrics.databaseBytes)}.
+                </> : 'Measuring browser-local storage…'}
+            </Typography>}
+            <Button variant="text" size="small" sx={{ alignSelf: 'flex-start' }} onClick={() => setStorageRefresh(value => value + 1)}>
+                Refresh storage metrics
+            </Button>
+        </Stack>
+    );
+}
